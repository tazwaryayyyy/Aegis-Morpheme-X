# Hedera Testnet Configuration
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.YOUR_ACCOUNT_ID
HEDERA_PRIVATE_KEY=302e0201003005...YOUR_PRIVATE_KEY

# HCS Topic IDs (create via Hedera portal or SDK)
HCS_TOPIC_ID=0.0.YOUR_MORPHEME_TOPIC_ID
HCS_SENTINEL_TOPIC_ID=0.0.YOUR_SENTINEL_TOPIC_ID

# HTS Token IDs
HTS_TOKEN_ID=0.0.YOUR_AMXSTAKE_TOKEN_ID

# Demo Mode (set to false for live Hedera transactions)
SIMULATE_HCS=true

# One Health Data
OPENWEATHER_API_KEY=your_openweathermap_api_key
WEATHER_CITY=Nairobi

# Backend settings
PORT=8000
LOG_LEVEL=INFO
